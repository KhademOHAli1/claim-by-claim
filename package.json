{
  "name": "claim-by-claim",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --bun next dev --webpack --hostname 127.0.0.1 --port 5173",
    "build": "bun --bun next build --webpack",
    "build:pages": "bun run build && bun deploy/prepare-pages.mjs",
    "test": "bun --bun playwright test",
    "check:content": "bun scripts/build-content.mjs --check",
    "db": "bun db/cli.mjs",
    "db:runner": "bun db/runner.mjs",
    "db:service": "bun db/service.mjs",
    "backend:check": "bun backend/deploy.mjs --check",
    "backend:deploy": "bun backend/deploy.mjs --deploy",
    "backend:status": "bun backend/status.mjs",
    "test:backend": "bun test backend/worker.test.mjs",
    "test:db": "bun test db/*.test.mjs",
    "test:worker": "bun test deploy/worker.test.mjs deploy/prepare.test.mjs",
    "check:types": "bun check",
    "deploy": "bun --bun cf deploy --prebuilt",
    "deploy:prepare": "bun deploy/prepare.mjs",
    "deploy:check": "bun --bun cf deploy --prebuilt --dry-run"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/react": "0.1.0-beta.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "flexlayout-react": "0.11.1",
    "lucide-react": "1.72.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cf": "^1.0.0-beta.31",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
